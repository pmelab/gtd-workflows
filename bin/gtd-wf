#!/usr/bin/env node
// gtd-wf: keep a pinned checkout of this repository that gtd.config.ts files
// import their workflows from, and start new workflows from existing ones.
import { execFileSync } from "node:child_process"
import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, realpathSync } from "node:fs"
import { homedir } from "node:os"
import { dirname, join, relative, resolve } from "node:path"

const REPO = resolve(realpathSync(import.meta.dirname), "..")
const WORKFLOWS = join(REPO, "workflows")
const PINNED = process.env.GTD_WF_PINNED ?? join(homedir(), ".local", "share", "gtd", "workflows")
const ORIGIN = "https://github.com/pmelab/gtd-workflows.git"

const die = (message) => {
  console.error(`gtd-wf: ${message}`)
  process.exit(1)
}

const git = (cwd, ...args) =>
  execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8" }).trim()

const tryGit = (cwd, ...args) => {
  try {
    return git(cwd, ...args)
  } catch {
    return undefined
  }
}

const NAME = /^[a-z][a-z0-9-]*$/
const workflowDir = (name) => {
  if (!NAME.test(name ?? "")) die(`"${name}" is not a workflow name (${NAME})`)
  return join(WORKFLOWS, name)
}

const workflows = (root) =>
  existsSync(join(root, "workflows"))
    ? readdirSync(join(root, "workflows")).filter((n) =>
        existsSync(join(root, "workflows", n, "index.ts")),
      )
    : []

const copy = (name, from) => {
  const src = workflowDir(from)
  const dest = workflowDir(name)
  if (!existsSync(src)) die(`no workflow "${from}"`)
  if (existsSync(dest)) die(`${relative(REPO, dest)} exists — pick another name`)
  cpSync(src, dest, { recursive: true })
  console.log(`copied ${from} to ${relative(REPO, dest)}`)
}

// gtd transpiles a config's TypeScript imports on every call — over a second
// for a whole workflow. A bundle, with gtd and effect left to resolve at
// runtime, is what repositories import instead.
const build = () => {
  for (const name of workflows(REPO)) {
    execFileSync(
      join(REPO, "node_modules", ".bin", "esbuild"),
      [
        join("workflows", name, "index.ts"),
        "--bundle",
        "--format=esm",
        "--platform=node",
        "--external:@pmelab/gtd/*",
        "--external:effect",
        `--outfile=${join("dist", `${name}.mjs`)}`,
        "--log-level=warning",
      ],
      { cwd: REPO, stdio: "inherit" },
    )
  }
  console.log(`built ${workflows(REPO).join(", ")} into ${join(REPO, "dist")}`)
}

const same = (a, b) => existsSync(a) && existsSync(b) && realpathSync(a) === realpathSync(b)

// Run from a working copy, `ref` names one of its commits, which the pinned
// checkout fetches from it; run from the pinned checkout itself, `ref` is a
// tag or a branch of this repository on GitHub.
const pin = (ref) => {
  const fromWorkingCopy = !same(REPO, PINNED)
  if (!existsSync(PINNED)) {
    mkdirSync(dirname(PINNED), { recursive: true })
    execFileSync("git", ["clone", "--quiet", ORIGIN, PINNED], { stdio: "inherit" })
  }
  if (git(PINNED, "status", "--porcelain") !== "") die(`${PINNED} has local changes`)
  let commit
  if (fromWorkingCopy) {
    commit = git(REPO, "rev-parse", "--verify", `${ref ?? "HEAD"}^{commit}`)
    if (tryGit(PINNED, "remote", "get-url", "local") === undefined)
      git(PINNED, "remote", "add", "local", REPO)
    git(PINNED, "fetch", "--quiet", "--tags", "local")
  } else {
    if (ref === undefined) die("name a tag or branch to pin, e.g. `gtd-wf pin origin/main`")
    git(PINNED, "fetch", "--quiet", "--tags", "origin")
    commit = git(PINNED, "rev-parse", "--verify", `${ref}^{commit}`)
  }
  const before = existsSync(join(PINNED, "package-lock.json"))
    ? readFileSync(join(PINNED, "package-lock.json"), "utf8")
    : undefined
  git(PINNED, "checkout", "--quiet", "--detach", commit)
  const lock = readFileSync(join(PINNED, "package-lock.json"), "utf8")
  if (lock !== before || !existsSync(join(PINNED, "node_modules"))) {
    // Runtime and build dependencies only: gtd itself is served by the running gtd.
    execFileSync("npm", ["ci", "--omit=dev", "--no-audit", "--no-fund"], {
      cwd: PINNED,
      stdio: "inherit",
    })
  }
  // The pinned commit's own gtd-wf: it knows how that commit builds.
  execFileSync(join(PINNED, "bin", "gtd-wf"), ["build"], { stdio: "inherit" })
  console.log(`pinned ${PINNED} at ${git(PINNED, "log", "-1", "--format=%h %s")}`)
}

const requires = (root, name) => {
  const file = join(root, "workflows", name, "EJECTED.json")
  return existsSync(file) ? JSON.parse(readFileSync(file, "utf8")).gtd : "?"
}

const status = () => {
  let running = "?"
  try {
    running = execFileSync("gtd", ["--version"], { encoding: "utf8" }).trim()
  } catch {}
  console.log(`gtd on PATH: ${running}`)
  if (!existsSync(PINNED)) {
    console.log("pinned: none — run `gtd-wf pin`")
    return
  }
  console.log(`pinned: ${PINNED} at ${git(PINNED, "log", "-1", "--format=%h %s")}`)
  if (!same(REPO, PINNED)) {
    const head = git(PINNED, "rev-parse", "HEAD")
    const ahead = tryGit(REPO, "rev-list", "--count", `${head}..HEAD`) ?? "?"
    console.log(`this working copy is ${ahead} commit(s) ahead of the pin`)
  }
  for (const name of workflows(PINNED))
    console.log(`  ${name}  (written against gtd ${requires(PINNED, name)})`)
}

const config = (name) => {
  const at = join(PINNED, "dist", `${name}.mjs`)
  if (!existsSync(at)) die(`the pinned checkout has no workflow "${name}" — run \`gtd-wf pin\``)
  process.stdout.write(`// Workflow "${name}" from the pinned checkout of pmelab/gtd-workflows
// (\`gtd-wf pin\` moves it).
import {
  feature as featureWorkflow,
  review as reviewWorkflow,
  fix as fixWorkflow,
} from "${at}"

export const feature = featureWorkflow()
export const review = reviewWorkflow()
export const fix = fixWorkflow()
export default feature
`)
}

const USAGE = `usage: gtd-wf <command>
  new <name> --from <name>  start a workflow as a copy of another
  build                     bundle every workflow into dist/
  pin [ref]                 check out ref in ${PINNED} and build it
  status                    show the pin and the workflows it carries
  config <name>             print a gtd.config.ts using the pinned workflow`

const [command, ...rest] = process.argv.slice(2)
const flag = (name) => {
  const at = rest.indexOf(name)
  return at === -1 ? undefined : rest.splice(at, 2)[1]
}
switch (command) {
  case "new": {
    const from = flag("--from")
    if (from === undefined) die("new needs --from <name>")
    copy(rest[0], from)
    break
  }
  case "build":
    build()
    break
  case "pin":
    pin(rest[0])
    break
  case "status":
    status()
    break
  case "config":
    config(rest[0])
    break
  default:
    console.log(USAGE)
    process.exit(command === undefined || command === "help" ? 0 : 1)
}
